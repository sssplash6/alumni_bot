# Copy to .env and fill in. Only BOT_TOKEN and ADMIN_IDS are needed to boot.

# From @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram user IDs allowed to run admin commands.
# Each of these people must /start the bot at least once — a bot cannot open a
# DM, so until they do, admin alerts and notifications silently fail.
#
# PUT YOUR GROUP LEADERS HERE. This list is what lets someone switch a community
# group on with /gate_announce, which is the Alumni Gate's trust root: membership
# of an approved group is what qualifies a person for the alumni group, so the
# question "may this group vouch for people" is answered by "is the person who
# approved it on this list". Leaving leaders off means every new group queues
# behind whoever is on it.
#
# It is one list, so everyone here ALSO gets /broadcast (messages every user of
# the bot), /backup (dumps the database), /gate_list (the full roster) and the
# mentor/mentee admin commands. If a leader shouldn't have those, split the list
# — see "Approved, not merely watched" in docs/ALUMNI_GATE.md.
#
# Get someone's ID: have them send /id to the bot in a private chat.
ADMIN_IDS=7185151344

# Optional: where the SQLite file lives (defaults to ./alumni_bot.db).
DB_PATH=/absolute/path/to/alumni_bot.db

# The @username users are told to contact when the bot refuses or fails them.
ADMIN_CONTACT=@gapyearingdoesntsuck

# ── Database backups ──────────────────────────────────────────────────────────
# Snapshots land in ./backups (gitignored). 0 hours disables the job; /backup
# still works on demand. Note these sit on the same disk as the database, so
# they guard against corruption, not against losing the host.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# BACKUP_DIR=/absolute/path/to/backups

# ── Alumni Gate ───────────────────────────────────────────────────────────────
# Master switch. While false the menu button says "coming soon", detection stays
# dormant and no gate jobs are scheduled. Flip to true once everything below is
# set and you've verified the bot's admin rights in the alumni group.
GATE_LIVE=false

# The DESTINATION: the one alumni group everyone should end up in. Stable —
# set it once. The bot must be an ADMIN here with "Add users / invite via link"
# rights, so it can read membership and mint invite links. Run /id in the group
# to find this. (The groups being WATCHED are managed separately, below.)
GATE_GROUP_ID=0

# OPTIONAL bootstrap only. The list of watched groups lives in the database and
# is managed live: add the bot to a group as an admin and run /gate_watch in it,
# /gate_unwatch to stop, /gate_groups to see the list. No restart, no config edit.
# Anything listed here is copied in once at startup; removing an id from this
# line does NOT unwatch the group — use /gate_unwatch.
GATE_MONITORED_GROUP_IDS=

# Minimum words in the intro before the invite link is issued. The onboarding
# brief asks for 50-100 words; without a floor a single "ok" opens the gate.
GATE_INTRO_MIN_WORDS=50

# How long an unredeemed invite code (/gate_token) stays usable, in days.
# 0 = never expires. These are issued for a named person joining now, so the
# window only has to cover them reading the message and opening the bot; a code
# that still works weeks later is a standing key to the Alumni group sitting in a
# chat nobody rereads. Re-issuing an expired one is a single command.
GATE_TOKEN_TTL_DAYS=3

# How often (days) to re-post the pinned "check if I'm in the Alumni group"
# announcement. This is the only way to reach people who were already in a
# monitored group before the bot arrived and who never post. 0 disables the
# re-post — post manually with /gate_announce instead.
GATE_ANNOUNCE_INTERVAL_DAYS=5

# How often (minutes) to re-check students still waiting on their form, so
# someone who submits but never taps the button isn't left stuck. 0 disables.
GATE_POLL_INTERVAL_MINUTES=3

# ── Alumni Gate: Airtable form verification ───────────────────────────────────
# Students are only admitted once their onboarding-form submission appears in
# Airtable. Leave this block blank to disable the form gate.
#
# The submission is matched to the person by Telegram user ID: the bot builds
# each student a personal form link with their ID pre-filled into a hidden
# field, so the match is exact and needs zero action from the student.
#
# Run `python scripts/check_airtable.py <your_telegram_id>` to verify this block
# before going live — the bot treats every Airtable error as "couldn't verify"
# and never rejects anyone, so a bad token looks exactly like an outage.

# Personal access token (airtable.com/create/tokens), data.records:read scope
# on the base below.
GATE_AIRTABLE_TOKEN=
# Base id — starts with "app".
GATE_AIRTABLE_BASE_ID=
# Table name (e.g. Onboarding) or table id (starts with "tbl").
GATE_AIRTABLE_TABLE=
# The hidden single-line-text field on the form holding the Telegram user ID.
# Must match the field name exactly (the bot prefills prefill_<this>=<id>).
GATE_AIRTABLE_TG_FIELD=tg_id
# Optional: a field that must be non-empty for the form to count as complete.
# Leave blank to treat any submitted row as complete.
GATE_AIRTABLE_DONE_FIELD=
# Optional: a field holding the student's full name.
#
# Serves two purposes. It's kept on the roster, and it enables the LAST-RESORT
# lookup: someone whose form is found by neither tg_id nor their stored username
# is asked for the name on their submission and matched by that. Pre-tg_id rows
# keep whatever handle the person had at the time, and handles change, so both
# other keys can miss a real alum.
#
# Weakest of the three keys, so it is tried last and only for people who already
# passed the watched-group eligibility check: a name is not secret, and someone
# who knows an alum's name could claim their row. Leave blank to disable both the
# roster name and the fallback.
GATE_AIRTABLE_NAME_FIELD=
# Optional: a field holding a student-typed Telegram username (e.g. "@alice"),
# used ONLY as a fallback for rows submitted before tg_id existed. Matching
# normalizes both sides (drops a leading @, lowercases, trims), and the bot
# compares against the username Telegram reports for whoever is talking to it —
# not anything the student types now. Quote the value if it contains spaces.
# Leave blank to require a tg_id match and ignore legacy rows.
GATE_AIRTABLE_USERNAME_FIELD=

# The public Airtable form share link. The bot appends the personal prefill.
GATE_FORM_URL=
# The values doc students are asked to read before joining.
GATE_VALUES_DOC_URL=

# Start watching a group automatically when the bot is made an admin there.
# The gate needs admin rights to work at all, so being promoted is already a
# deliberate act by whoever runs that group. Set false to require /gate_watch.
GATE_AUTO_WATCH=true

# Only let people onboard if they're in at least one watched group.
#
# Leave this on. The bot's username is public, so with it off the only thing
# between a stranger and a working invite link is submitting a public form —
# nobody reviews it, and a submitted form is what "verified" means. Turn it off
# only if the alumni group is genuinely open to anyone who asks.
#
# Note this makes the watched-group list load-bearing: with it on and no groups
# watched, nobody can onboard at all (the bot says so in the log).
GATE_REQUIRE_WATCHED_GROUP=true

# ── Event registration (event/settings.py) ────────────────────────────────────
# Registration requires being in BOTH chats below. Whoever is in one gets a
# one-time link to the other and is picked up when they join; whoever is in
# neither is told the event is alumni-only and gets no link.
#
# The bot must be an ADMIN in BOTH, with "invite users via link" — that is what
# makes membership readable, links mintable, and join events delivered.

# Master switch. While false the menu button says "coming soon". Flip on once
# both IDs are set AND the post has been saved with /event_set_post.
EVENT_LIVE=false

# The alumni group and the alumni channel. Both private is fine — the bot works
# from IDs, not usernames.
EVENT_GROUP_ID=
EVENT_CHANNEL_ID=

# The post itself is NOT configured here: it carries an image, so it's set at
# runtime by replying to it with /event_set_post. Admin commands: /event_list
# (attendee list) and /event_stats (counts per status).
